{
  "schemaVersion": 1,
  "distribution": "dll-only",
  "files": [
    {
      "source": "upstream",
      "path": "pg_failover_slots.dll",
      "destination": "lib/pg_failover_slots.dll",
      "targets": [
        "install",
        "zip"
      ]
    },
    {
      "source": "license",
      "path": "LICENSE",
      "destination": "LICENSE",
      "targets": [
        "zip"
      ]
    },
    {
      "source": "upstream",
      "path": "README.md",
      "destination": "UPSTREAM-README.md",
      "targets": [
        "zip"
      ]
    }
  ],
  "packageInfo": [
    "pg_failover_slots Windows package",
    "=================================",
    "Upstream repository: {upstreamRepository}",
    "Upstream ref: {upstreamRef}",
    "Upstream commit: {upstreamCommit}",
    "pg_failover_slots version: {version}",
    "PostgreSQL major: {pgMajor}",
    "PostgreSQL tested: {pgTested}",
    "Architecture: Windows x64",
    "Compiler: MSVC x64",
    "License: PostgreSQL; see LICENSE",
    "",
    "This is an unofficial pgextwin Windows package built from the official pg_failover_slots source.",
    "Shared-preload library only (no CREATE EXTENSION, no SQL files).",
    "Requires shared_preload_libraries=pg_failover_slots."
  ],
  "packageInfoFinalNewline": true
}
